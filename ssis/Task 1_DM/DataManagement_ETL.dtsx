      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E89FF25D-53DD-4AFD-A1C3-7F168C5933F8}"
          SQLTask:SqlStatementSource="TRUNCATE TABLE dbo.FactSales;&#xA;&#xA;TRUNCATE TABLE dbo.RejectedSales;&#xA;&#xA;TRUNCATE TABLE dbo.StgSales;&#xA;&#xA;TRUNCATE TABLE dbo.StgCustomers;&#xA;&#xA;TRUNCATE TABLE dbo.StgProducts;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Final_Summary"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{77BD235A-1C11-4867-88CE-6AE6FB416836}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Final_Summary"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E89FF25D-53DD-4AFD-A1C3-7F168C5933F8}"
          SQLTask:SqlStatementSource="SELECT&#xA;    (SELECT COUNT(*) FROM dbo.FactSales) AS ValidSales,&#xA;    (SELECT COUNT(*) FROM dbo.RejectedSales) AS RejectedSales,&#xA;    (SELECT SUM(TotalAmount) FROM dbo.FactSales) AS TotalSalesAmount;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
